---
import {
  referenceSidebarSections,
  referenceSurfaceForPath,
  sectionForUrl,
  type SidebarTreeEntry,
} from '../lib/docs-sections';

const { sidebar } = Astro.locals.starlightRoute;
const currentPath = Astro.url.pathname;
type SidebarEntry = (typeof sidebar)[number];
type SidebarLink = Extract<SidebarEntry, { type: 'link' }>;
type SidebarGroup = Extract<SidebarEntry, { type: 'group' }>;

const surface = referenceSurfaceForPath(currentPath);
const currentSection = surface?.label ?? sectionForUrl(currentPath);
const activeGroup = sidebar.find(
  (entry): entry is SidebarGroup => entry.type === 'group' && entry.label === currentSection,
);
const filteredSidebar: readonly SidebarEntry[] = activeGroup?.entries ?? [];
const showSidebar = filteredSidebar.length > 0 || Boolean(surface);
const isReference = Boolean(surface);

function flattenLinks(entries: readonly SidebarEntry[]): SidebarLink[] {
  const links: SidebarLink[] = [];
  for (const entry of entries) {
    if (entry.type === 'link') {
      links.push(entry);
    } else {
      links.push(...flattenLinks(entry.entries));
    }
  }
  return links;
}

const leafOnly =
  filteredSidebar.length > 0 && filteredSidebar.every((entry) => entry.type === 'link');
const childSections = leafOnly && activeGroup
  ? [
      {
        label: activeGroup.label,
        href: undefined as string | undefined,
        isCurrent: false,
        items: flattenLinks(activeGroup.entries),
      },
    ]
  : filteredSidebar.map((entry) => {
      if (entry.type === 'link') {
        return {
          label: entry.label,
          href: entry.href,
          isCurrent: entry.isCurrent,
          items: [] as SidebarLink[],
        };
      }
      return {
        label: entry.label,
        href: undefined as string | undefined,
        isCurrent: false,
        items: flattenLinks(entry.entries),
      };
    });
const sections = surface
  ? referenceSidebarSections(
      surface,
      (activeGroup?.entries ?? []) as SidebarTreeEntry[],
      currentPath,
    )
  : childSections;
---

{
  showSidebar ? (
    <>
      <ul
        class:list={[
          'tg-tutorial-sidebar',
          { 'is-reference': isReference },
        ]}
        data-sidebar-key={currentSection ?? 'Home'}
      >
        {sections.map((section) => (
          <li>
            {section.href ? (
              <a
                href={section.href}
                class:list={['tg-tutorial-sidebar__header', { active: section.isCurrent }]}
              >
                {section.label}
              </a>
            ) : (
              <span class="tg-tutorial-sidebar__header">{section.label}</span>
            )}
            {section.items.map((item) => (
              <a
                href={item.href}
                class:list={['tg-tutorial-sidebar__item', { active: item.isCurrent }]}
              >
                {item.label}
              </a>
            ))}
          </li>
        ))}
      </ul>
    </>
  ) : (
    <div class="tg-sidebar-empty" aria-hidden="true" />
  )
}

<script is:inline>
  (function () {
    var list = document.querySelector('#starlight__sidebar .tg-tutorial-sidebar');
    var pane = list && list.closest('.sidebar-pane');
    if (!(list instanceof HTMLElement) || !(pane instanceof HTMLElement)) return;
    var key = 'tg-sidebar-scroll:' + (list.getAttribute('data-sidebar-key') || 'Home');
    try {
      var raw = sessionStorage.getItem(key);
      var top = raw == null ? NaN : Number(raw);
      if (Number.isFinite(top)) pane.scrollTop = top;
    } catch (e) {}
  })();
</script>

<script>
  import { nextPaneScrollTop, sidebarScrollKey } from '../lib/sidebar-scroll';

  function sidebarPane(): { list: HTMLElement; pane: HTMLElement; key: string } | null {
    const list = document.querySelector('#starlight__sidebar .tg-tutorial-sidebar');
    if (!(list instanceof HTMLElement)) return null;
    const pane = list.closest('.sidebar-pane');
    if (!(pane instanceof HTMLElement)) return null;
    return {
      list,
      pane,
      key: sidebarScrollKey(list.getAttribute('data-sidebar-key') || 'Home'),
    };
  }

  function persistSidebarScroll() {
    const found = sidebarPane();
    if (!found) return;
    try {
      sessionStorage.setItem(found.key, String(found.pane.scrollTop));
    } catch {
      return;
    }
  }

  function nudgeActiveItem() {
    const found = sidebarPane();
    if (!found) return;
    const active = found.list.querySelector('.active');
    if (!(active instanceof HTMLElement)) return;
    const itemOffsetTop =
      active.getBoundingClientRect().top -
      found.pane.getBoundingClientRect().top +
      found.pane.scrollTop;
    found.pane.scrollTop = nextPaneScrollTop(
      found.pane.scrollTop,
      found.pane.clientHeight,
      itemOffsetTop,
      active.offsetHeight,
    );
  }

  function bindSidebarScroll() {
    const found = sidebarPane();
    if (!found) return;
    found.pane.addEventListener('scroll', persistSidebarScroll, { passive: true });
    found.pane.addEventListener('click', persistSidebarScroll);
    requestAnimationFrame(nudgeActiveItem);
  }

  bindSidebarScroll();
  document.addEventListener('astro:page-load', bindSidebarScroll);
</script>
