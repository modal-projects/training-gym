---
import {
  referenceSidebarSections,
  referenceSurfaceForPath,
  sectionForUrl,
  type SidebarTreeEntry,
} from '../lib/docs-sections';

const { sidebar } = Astro.locals.starlightRoute;
const currentPath = Astro.url.pathname;
type SidebarEntry = (typeof sidebar)[number];
type SidebarLink = Extract<SidebarEntry, { type: 'link' }>;
type SidebarGroup = Extract<SidebarEntry, { type: 'group' }>;

const surface = referenceSurfaceForPath(currentPath);
const currentSection = surface?.label ?? sectionForUrl(currentPath);
const activeGroup = sidebar.find(
  (entry): entry is SidebarGroup => entry.type === 'group' && entry.label === currentSection,
);
const filteredSidebar: readonly SidebarEntry[] = activeGroup?.entries ?? [];
const showSidebar = filteredSidebar.length > 0 || Boolean(surface);
const isReference = Boolean(surface);

function flattenLinks(entries: readonly SidebarEntry[]): SidebarLink[] {
  const links: SidebarLink[] = [];
  for (const entry of entries) {
    if (entry.type === 'link') {
      links.push(entry);
    } else {
      links.push(...flattenLinks(entry.entries));
    }
  }
  return links;
}

const leafOnly =
  filteredSidebar.length > 0 && filteredSidebar.every((entry) => entry.type === 'link');
const childSections = leafOnly && activeGroup
  ? [
      {
        label: activeGroup.label,
        href: undefined as string | undefined,
        isCurrent: false,
        items: flattenLinks(activeGroup.entries),
      },
    ]
  : filteredSidebar.map((entry) => {
      if (entry.type === 'link') {
        return {
          label: entry.label,
          href: entry.href,
          isCurrent: entry.isCurrent,
          items: [] as SidebarLink[],
        };
      }
      return {
        label: entry.label,
        href: undefined as string | undefined,
        isCurrent: false,
        items: flattenLinks(entry.entries),
      };
    });
const sections = surface
  ? referenceSidebarSections(
      surface,
      (activeGroup?.entries ?? []) as SidebarTreeEntry[],
      currentPath,
    )
  : childSections;
---

{
  showSidebar ? (
    <>
      <ul
        class:list={[
          'tg-tutorial-sidebar',
          { 'is-reference': isReference },
        ]}
      >
        {sections.map((section) => (
          <li>
            {section.href ? (
              <a
                href={section.href}
                class:list={['tg-tutorial-sidebar__header', { active: section.isCurrent }]}
              >
                {section.label}
              </a>
            ) : (
              <span class="tg-tutorial-sidebar__header">{section.label}</span>
            )}
            {section.items.map((item) => (
              <a
                href={item.href}
                class:list={['tg-tutorial-sidebar__item', { active: item.isCurrent }]}
              >
                {item.label}
              </a>
            ))}
          </li>
        ))}
      </ul>
    </>
  ) : (
    <div class="tg-sidebar-empty" aria-hidden="true" />
  )
}

<script>
  function revealActiveSidebarItem() {
    const active = document.querySelector('#starlight__sidebar .tg-tutorial-sidebar .active');
    if (!(active instanceof HTMLElement)) return;
    const pane = active.closest('.sidebar-pane');
    if (!(pane instanceof HTMLElement)) return;
    const paneRect = pane.getBoundingClientRect();
    const itemRect = active.getBoundingClientRect();
    pane.scrollTop +=
      itemRect.top - paneRect.top - pane.clientHeight / 2 + itemRect.height / 2;
  }

  function revealAfterLayout() {
    revealActiveSidebarItem();
    requestAnimationFrame(revealActiveSidebarItem);
  }

  revealAfterLayout();
  document.addEventListener('astro:page-load', revealAfterLayout);
</script>
