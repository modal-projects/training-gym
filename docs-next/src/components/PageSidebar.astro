---
import { Code } from 'astro-expressive-code/components';
import MobileTableOfContents from '@astrojs/starlight/components/MobileTableOfContents.astro';
import TableOfContents from '@astrojs/starlight/components/TableOfContents.astro';
import { isTutorialPage } from '../lib/tutorial-page';

const { toc, entry } = Astro.locals.starlightRoute;
const runCommand =
  typeof entry.data.runCommand === 'string' ? entry.data.runCommand : '';
const isTutorial = isTutorialPage(entry.id);
const showTutorialCta = isTutorial && Boolean(runCommand);
const showDefaultCta = Boolean(toc) && !isTutorial;
const commands = showTutorialCta
  ? [
      'git clone https://github.com/modal-projects/training-gym',
      'cd training-gym',
      runCommand,
    ]
  : [];
const shellCode = commands.join('\n');
---

{toc && (
  <div class="tg-mobile-toc lg:sl-hidden">
    <MobileTableOfContents />
  </div>
)}
{(toc || showTutorialCta) && (
  <div class="right-sidebar-panel sl-hidden lg:sl-block">
    <div class="sl-container tg-right-rail">
      {toc && (
        <div class="tg-right-rail__toc">
          <TableOfContents />
          <script is:inline>
            (() => {
              const root = document.currentScript?.parentElement;
              const hash = window.location.hash || '#_top';
              const current = [...(root?.querySelectorAll('a') ?? [])].find(
                (link) => link.getAttribute('href') === hash,
              );
              current?.setAttribute('aria-current', 'true');
            })();
          </script>
        </div>
      )}
      {showTutorialCta && (
        <aside class="tg-right-rail__cta tg-right-rail__cta--tutorial">
          <h2>Try this now!</h2>
          <Code lang="bash" code={shellCode} />
        </aside>
      )}
      {showDefaultCta && (
        <aside class="tg-right-rail__cta">
          <p class="tg-right-rail__eyebrow">Training Gym</p>
          <h2>Run RL post-training on Modal.</h2>
          <p>Browse the runnable RL tutorials and framework launchers that ship with this repo.</p>
          <div class="tg-right-rail__links">
            <a class="tg-action-button tg-action-button--primary" href="/tutorials/">
              Open tutorials
            </a>
            <a
              class="tg-action-button tg-action-button--ghost"
              href="https://github.com/modal-projects/training-gym"
            >
              GitHub repo
            </a>
          </div>
        </aside>
      )}
    </div>
  </div>
)}
