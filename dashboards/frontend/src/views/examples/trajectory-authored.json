{
  "id": "trajectory-authored-example",
  "scope": "user",
  "title": "Compact trajectory timeline",
  "accepts": "run.rollouts",
  "component": null,
  "config": {},
  "forked_from": "builtin:rollout-explorer",
  "code": "<script>\n  import { ConversationView } from \"$host/components\";\n  import { fmtDuration } from \"$host/format\";\n  import { doc } from \"$host/data\";\n\n  let { context = {}, data = null } = $props();\n  let rollouts = doc(`gym/runs/${context.run_id}/rollouts`, { poll_ms: 5000 });\n  let selected = $state(null);\n  let detail = $state(null);\n\n  async function select(row) {\n    selected = row;\n    const response = await fetch(`/api/docs/gym/runs/${context.run_id}/rollouts/${row.rollout_id}`);\n    detail = response.ok ? await response.json() : null;\n  }\n</script>\n\n<div class=\"trajectory-example\">\n  <div class=\"trajectory-heading\">\n    <div>\n      <div class=\"eyebrow\">Authored view</div>\n      <h3>Compact trajectory timeline</h3>\n    </div>\n    <span>{rollouts.data?.length || 0} rollouts</span>\n  </div>\n  <div class=\"trajectory-list\">\n    {#each (rollouts.data || []) as row (row.rollout_id)}\n      <button class:selected={selected?.rollout_id === row.rollout_id} onclick={() => select(row)}>\n        <span class=\"dot\"></span>\n        <span class=\"step\">step {row.rollout_id}</span>\n        <strong>{Number(row.mean || 0).toFixed(3)}</strong>\n        <span class=\"duration\">{row.rollout_time ? fmtDuration(row.created_at, row.created_at + row.rollout_time) : \"—\"}</span>\n      </button>\n    {:else}\n      <div class=\"empty\">Waiting for rollout data…</div>\n    {/each}\n  </div>\n  {#if detail?.samples?.[0]}\n    {@const sample = detail.samples[0]}\n    <article class=\"trajectory-detail\">\n      <div class=\"timeline-marker\"><span class=\"dot\"></span></div>\n      <div class=\"timeline-body\">\n        <div class=\"eyebrow\">rollout {selected.rollout_id} · score {Number(sample.score || 0).toFixed(3)}</div>\n        {#if sample.prompt}<p class=\"prompt\">{sample.prompt}</p>{/if}\n        <ConversationView messages={sample.metadata?.trajectory_messages} response={sample.response || \"\"} thinking={sample.thinking || \"\"} evalReport={sample.metadata?.eval_report} />\n        {#if sample.trace?.length}\n          <div class=\"trace\">{#each sample.trace as event}<span title={event.kind || \"event\"}></span>{/each}</div>\n        {/if}\n      </div>\n    </article>\n  {/if}\n</div>\n\n<style>\n  .trajectory-example { color: var(--text); border: 1px solid var(--border); border-radius: 8px; background: var(--panel); padding: 14px; }\n  .trajectory-heading { display: flex; justify-content: space-between; gap: 12px; align-items: start; border-bottom: 1px solid var(--border); padding-bottom: 10px; }\n  .trajectory-heading h3 { color: var(--text-bright); font-size: 14px; margin: 2px 0 0; }\n  .trajectory-heading > span { color: var(--muted); font-size: 11px; }\n  .eyebrow { color: var(--muted); font-size: 10px; letter-spacing: .06em; text-transform: uppercase; }\n  .trajectory-list { display: grid; gap: 4px; padding: 10px 0; }\n  .trajectory-list button { display: grid; grid-template-columns: 10px 1fr auto auto; align-items: center; gap: 8px; border: 0; border-radius: 5px; background: transparent; color: var(--text); cursor: pointer; padding: 7px 8px; text-align: left; }\n  .trajectory-list button:hover, .trajectory-list button.selected { background: var(--surface); }\n  .trajectory-list .step, .duration { color: var(--muted); font-size: 11px; }\n  .trajectory-list strong { color: var(--text-bright); font-size: 12px; font-variant-numeric: tabular-nums; }\n  .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--green); display: inline-block; }\n  .empty { color: var(--muted); font-size: 12px; padding: 10px 8px; }\n  .trajectory-detail { display: grid; grid-template-columns: 12px 1fr; gap: 10px; border-top: 1px solid var(--border); padding-top: 12px; }\n  .timeline-marker { border-right: 1px solid var(--accent); position: relative; }\n  .timeline-marker .dot { position: absolute; top: 2px; right: -4px; box-shadow: 0 0 0 3px var(--panel); }\n  .timeline-body { min-width: 0; }\n  .prompt { color: var(--text-bright); font-size: 12px; margin: 7px 0 10px; white-space: pre-wrap; }\n  .trace { display: flex; gap: 3px; margin-top: 10px; }\n  .trace span { width: 12px; height: 4px; border-radius: 2px; background: var(--accent); opacity: .7; }\n</style>"
}
