# Kimi K3 team endpoint — the default learning-agent model (2026-08-12).
# ONE pinned source of truth: every scaffold that drives this endpoint
# sources this file. Served by `ep-kimi-k3-server` in lab-dev (us-west).
#
# MODAL_KIMI3_MODEL may be left empty: the scaffold resolves the served
# model id from /v1/models at launch, so the id lives server-side and a
# server rename cannot silently split the config from reality.
MODAL_KIMI3_BASE_URL="https://modal-labs-lab-dev--ep-kimi-k3-server.us-west.modal.direct"
MODAL_KIMI3_MODEL=""
