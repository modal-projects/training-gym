# Learning Toolbox — example environment
# Copy to .env and fill in as needed:   cp toolbox/.env.example toolbox/.env
# Nothing here is required for the OFFLINE smoke (mock backends read no env).
# Do NOT put real secrets in .env.example — this file is a template only.

# Task model / generator model id. Fills --model for the data-toolbox generators and
# for rubric_eval.py's answer generation when you don't pass --model explicitly.
TASK_MODEL=your-task-model-id

# Judge model id for the eval-toolbox LLM-as-judge. Fills --model / --judge-model
# for judge_client.py / rubric_eval.py when unset on the command line.
JUDGE_MODEL=your-judge-model-id

# OPTIONAL. If set, enables the canonical `api` judge (Anthropic Messages API);
# --judge-backend auto then picks `api` over the non-canonical `claude` CLI.
# Leave unset to use --judge-backend cli (real, non-canonical) or mock (offline).
# ANTHROPIC_API_KEY=

# Note: a SERVED task model is reached over an OpenAI-compatible endpoint via the
# --base-url flag, not an env var, e.g.  --base-url http://host:port/v1
